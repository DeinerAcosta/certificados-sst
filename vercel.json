{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "functions": {
    "api/certificate/**": {
      "includeFiles": "assets/certificate/**"
    }
  },
  "headers": [
    {
      "source": "/api/((?!certificate/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/certificate/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
